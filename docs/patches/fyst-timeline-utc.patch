+def _iso_utc(value: Time) -> str:
+    """Serialize an absolute instant with UTC offset and datetime microsecond precision.
+
+    TOAST uses datetime.fromisoformat, then timestamp(). A naive ISO string
+    would be interpreted in the consumer's local timezone. Use +00:00 (also
+    supported by Python 3.10) and avoid Time.iso's configurable display precision.
+    """
+    return value.utc.to_datetime(timezone=timezone.utc).isoformat(timespec="microseconds")
+
+
+def _read_time(value: str) -> Time:
+    """Accept legacy astropy time strings and ISO strings with explicit UTC offsets."""
+    try:
+        return Time(value, scale="utc")
+    except ValueError:
+        return Time(datetime.fromisoformat(value.replace("Z", "+00:00")), scale="utc")
+
