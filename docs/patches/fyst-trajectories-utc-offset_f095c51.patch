+def _iso_utc(value: Time | str) -> str:
+    """Serialize a normalized UTC instant with an offset and microsecond precision."""
+    return _utc_instant(value).to_datetime(timezone=timezone.utc).isoformat(timespec="microseconds")
+
+
+def _read_time(value: str) -> Time:
+    """Read legacy astropy strings or ISO strings with an explicit UTC offset."""
+    try:
+        return Time(value, scale="utc")
+    except ValueError:
+        return Time(datetime.fromisoformat(value.replace("Z", "+00:00")), scale="utc")
+
